<?xml version="1.0"?>
<configuration>
  <property>
    <name>hbase.rootdir</name>
    <value>hdfs://hadoop-master:9000/hbase</value>
  </property>
  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>zookeeper</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.dataDir</name>
    <value>/opt/hadoop-data/zk</value>
  </property>
  <property>
    <!-- The default async/fan-out WAL writer uses reflection against
         HDFS-internal classes and was flaky here during earlier version
         mismatches. The plain filesystem WAL provider is a safe, proven
         (if slightly less optimized) alternative, kept even after fixing
         the underlying version mismatch since there's no need to churn it
         again. -->
    <name>hbase.wal.provider</name>
    <value>filesystem</value>
  </property>
  <property>
    <!-- Docker's embedded DNS gives each container both a short hostname
         and an FQDN (e.g. hadoop-worker2.modern_hadoop_hadoop-net). The
         Master's reverse-DNS lookup on the RegionServer's RPC connection
         resolves the FQDN, which doesn't match the short hostname the
         RegionServer self-reports, so it aborts. Trust the self-reported
         hostname instead of re-resolving it. -->
    <name>hbase.regionserver.hostname.disable.master.reversedns</name>
    <value>true</value>
  </property>
  <property>
    <!-- HBase 3.x clients bootstrap master discovery from hbase.masters,
         which defaults to the CLIENT's own hostname if unset (assuming
         you're running the shell colocated with a master). That only
         worked by coincidence on hbase-master itself; every other
         container (airflow, jupyterlab, ...) connected to its own
         hostname:16000 and got "Connection refused". Must be explicit. -->
    <name>hbase.masters</name>
    <value>hbase-master:16000</value>
  </property>
</configuration>
